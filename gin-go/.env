QUARKUS_HTTP_PORT=8080
QUARKUS_PROFILE=dev
GIN_MODE=debug

# PostgreSQL configuration
QUARKUS_DATASOURCE_DB_TYPE=postgresql
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://localhost:38755/mydb
QUARKUS_DATASOURCE_USERNAME=postgres
QUARKUS_DATASOURCE_PASSWORD=yourpassword
QUARKUS_DATASOURCE_QUERY=SELECT id, name, email FROM users

# MongoDB configuration
QUARKUS_MONGODB_CONNECTION_STRING=mongodb://admin:password@localhost:27017/mydb
QUARKUS_MONGODB_DATABASE=mydb